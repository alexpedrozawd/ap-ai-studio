[Unit]
Description=AP AI Studio - Interface Web (FastAPI/uvicorn)
# A webui escuta APENAS no IP da tailnet (decisao de 2026-07-26, coerente com o
# security-audit: nada exposto na LAN). Isso cria uma dependencia real de ordem - se o
# tailscaled ainda nao subiu, a interface nao existe e o uvicorn morre com
# "Cannot assign requested address". Por isso o After/Wants abaixo, mais o Restart.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Caminhos e endereco vem do EnvironmentFile - NUNCA hardcoded aqui: este repositorio e'
# publico, e a versao anterior deste arquivo vazou o IP Tailscale do servidor antigo.
# Ver webui/vfx-webui.env.example para gerar o seu.
EnvironmentFile=%h/.config/ap-ai-studio/webui.env
WorkingDirectory=%h/ap-ai-studio/webui/backend
ExecStart=%h/ap-ai-studio/miniconda3/envs/webui-pipeline/bin/python -m uvicorn main:app --host ${WEBUI_HOST} --port ${WEBUI_PORT}
Restart=on-failure
# Reinicio generoso: se o tailscaled demorar a estabelecer a interface, o bind falha
# algumas vezes antes de dar certo. Sem isso o servico desiste e a webui fica fora do ar
# ate alguem religar na mao.
RestartSec=10
StartLimitBurst=10
StartLimitIntervalSec=300

[Install]
WantedBy=default.target
