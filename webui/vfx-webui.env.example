# Configuracao da interface web do AP AI Studio.
#
# Copie para ~/.config/ap-ai-studio/webui.env e ajuste. Este arquivo NAO vai pro git com
# valores reais de proposito: o repositorio e' publico e o IP da tailnet e' informacao de
# infraestrutura (a versao anterior do .service vazou o IP do servidor antigo).
#
# Para descobrir o IP Tailscale desta maquina:
#   tailscale ip -4
#
# Deixar WEBUI_HOST no IP da tailnet mantem a interface invisivel na LAN, coerente com o
# hardening do security-audit. Use 127.0.0.1 se preferir acessar so' por tunel SSH.

WEBUI_HOST=100.64.0.1
WEBUI_PORT=8299

# Raiz da instalacao. Todo o codigo respeita esta variavel; nao ha caminho fixo.
AP_AI_STUDIO_HOME=/var/home/apsrv/ap-ai-studio

# Execution provider do onnxruntime no FaceFusion. 'cpu' e' o padrao nesta GPU (RDNA4/
# gfx1201 ainda sem wheel oficial de onnxruntime-rocm). Trocar para 'rocm' quando houver.
AP_AI_STUDIO_EXECUTION_PROVIDER=cpu
